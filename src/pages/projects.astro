---
import Base from '../layouts/Base.astro';
import { projects, statusMap } from '../data/projects';
---

<Base
  title="Projects — Dandy1aw"
  description="用 AI 和代码构建的项目。"
>
  <div class="max-w-2xl mx-auto px-6 pt-16 pb-24">

    <div class="fade-up mb-12">
      <h1 class="text-3xl font-bold text-[var(--color-text)] tracking-tight">Projects</h1>
      <p class="mt-3 text-[var(--color-muted)] leading-relaxed">用代码构建的小东西。</p>
    </div>

    <div class="space-y-5">
      {projects.map((project, i) => {
        const status = statusMap[project.status];
        const Tag = project.url ? 'a' : 'div';
        return (
          <Tag
            href={project.url ?? undefined}
            target={project.url ? '_blank' : undefined}
            rel={project.url ? 'noopener noreferrer' : undefined}
            class={`fade-up block p-6 rounded-2xl card-glass transition-all duration-200 ${project.url ? 'cursor-pointer hover:border-purple-500/40' : ''}`}
            style={`transition-delay:${i * 80}ms`}
          >
            <div class="flex items-start justify-between gap-4 mb-3">
              <div>
                <h2 class="text-lg font-semibold text-[var(--color-text)] leading-tight">{project.name}</h2>
                <p class="text-sm text-[var(--color-muted)] mt-0.5">{project.subtitle}</p>
              </div>
              <span class={`flex-shrink-0 text-xs font-medium px-2.5 py-1 rounded-full border ${status.color}`}>
                {status.label}
              </span>
            </div>

            <p class="text-sm text-[var(--color-muted)] leading-relaxed mb-4">
              {project.description}
            </p>

            <div class="flex flex-wrap gap-2">
              {project.stack.map(tech => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">
                  {tech}
                </span>
              ))}
            </div>
          </Tag>
        );
      })}
    </div>

  </div>
</Base>
