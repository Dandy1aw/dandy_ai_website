---
import { projects, statusMap } from '../../data/projects';

const STACK_PREVIEW = 3;
---

<section class="py-20 px-6">
  <div class="max-w-6xl mx-auto">

    <div class="fade-up flex items-end justify-between mb-10">
      <h2 class="text-2xl sm:text-3xl font-bold text-[var(--color-text)] tracking-tight">Projects</h2>
      <a
        href="/projects"
        class="text-sm text-[var(--color-muted)] hover:text-[var(--color-accent)] transition-colors flex items-center gap-1.5"
      >
        查看全部
        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
      {projects.map((project, i) => {
        const status = statusMap[project.status];
        const visibleStack = project.stack.slice(0, STACK_PREVIEW);
        const remaining = project.stack.length - STACK_PREVIEW;
        const Tag = project.url ? 'a' : 'div';
        return (
          <Tag
            href={project.url ?? undefined}
            target={project.url ? '_blank' : undefined}
            rel={project.url ? 'noopener noreferrer' : undefined}
            class={`fade-up p-6 rounded-2xl card-glass flex flex-col gap-4 transition-all duration-200 ${project.url ? 'cursor-pointer hover:border-purple-500/40' : ''}`}
            style={`transition-delay:${i * 80}ms`}
          >
            <div class="flex items-start justify-between gap-3">
              <div>
                <h3 class="font-semibold text-[var(--color-text)] leading-snug">{project.name}</h3>
                <p class="text-sm text-[var(--color-muted)] mt-0.5">{project.subtitle}</p>
              </div>
              <span class={`flex-shrink-0 text-xs font-medium px-2.5 py-1 rounded-full border ${status.color}`}>
                {status.label}
              </span>
            </div>

            <div class="flex flex-wrap gap-2">
              {visibleStack.map(tech => (
                <span class="text-xs px-2.5 py-1 rounded-full bg-purple-500/10 text-purple-300 border border-purple-500/20">
                  {tech}
                </span>
              ))}
              {remaining > 0 && (
                <span class="text-xs px-2.5 py-1 rounded-full bg-white/5 text-[var(--color-muted)] border border-white/10">
                  +{remaining}
                </span>
              )}
            </div>
          </Tag>
        );
      })}
    </div>

  </div>
</section>
