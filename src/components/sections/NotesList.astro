---
import Tag from '../ui/Tag.astro';
import type { Note } from '../../lib/content';
import { formatDate } from '../../lib/utils';

interface Props {
  notes: Note[];
}
const { notes } = Astro.props;

const tags = ['AI Tools', 'Recommendation', 'Product Engineering', 'Thinking'] as const;
---

<section class="max-w-3xl mx-auto px-6 py-10">
  <!-- Tag filter bar -->
  <div class="flex flex-wrap gap-2 mb-10" id="tag-filter">
    <button
      data-tag="all"
      class="tag-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer min-h-[44px] bg-[var(--color-accent)] text-white"
    >
      All
    </button>
    {tags.map(tag => (
      <button
        data-tag={tag}
        class="tag-btn px-4 py-2 rounded-full text-sm font-medium transition-all duration-200 cursor-pointer min-h-[44px] bg-[var(--color-bg)] border border-[var(--color-border)] text-[var(--color-muted)] hover:text-[var(--color-text)] hover:border-[var(--color-text)]"
      >
        {tag}
      </button>
    ))}
  </div>

  <!-- Article list -->
  <div class="divide-y divide-[var(--color-border)]">
    {notes.map(note => (
      <article
        class="note-row py-6 fade-up"
        data-tag={note.tag}
      >
        <a href={`/notes/${note.id}`} class="group block cursor-pointer">
          <h2 class="text-base sm:text-lg font-semibold text-[var(--color-text)] group-hover:text-[var(--color-accent)] transition-colors duration-200 leading-snug">
            {note.title}
          </h2>
          <p class="mt-1.5 text-sm text-[var(--color-muted)] leading-relaxed">{note.description}</p>
          <div class="mt-2 flex items-center gap-2 flex-wrap">
            <span class="text-xs text-[var(--color-muted)]">{formatDate(note.date)}</span>
            <span class="text-xs text-[var(--color-border)]">·</span>
            <Tag label={note.tag} />
            <span class="text-xs text-[var(--color-border)]">·</span>
            <span class="text-xs text-[var(--color-muted)]">{note.readingTime} min read</span>
          </div>
        </a>
      </article>
    ))}
  </div>
</section>

<script>
  // Restore tag from URL ?tag= param on load, wire up filter buttons
  const params = new URLSearchParams(window.location.search);
  const initialTag = params.get('tag') ?? 'all';

  function applyFilter(tag: string) {
    // Update button active styles
    document.querySelectorAll<HTMLButtonElement>('.tag-btn').forEach(btn => {
      const isActive = btn.dataset.tag === tag;
      btn.classList.toggle('bg-[var(--color-accent)]', isActive);
      btn.classList.toggle('text-white', isActive);
      btn.classList.toggle('bg-[var(--color-bg)]', !isActive);
      btn.classList.toggle('border', !isActive);
      btn.classList.toggle('border-[var(--color-border)]', !isActive);
      btn.classList.toggle('text-[var(--color-muted)]', !isActive);
    });

    // Show/hide article rows
    document.querySelectorAll<HTMLElement>('.note-row').forEach(row => {
      row.style.display = (tag === 'all' || row.dataset.tag === tag) ? '' : 'none';
    });

    // Sync URL
    const url = new URL(window.location.href);
    if (tag === 'all') {
      url.searchParams.delete('tag');
    } else {
      url.searchParams.set('tag', tag);
    }
    window.history.replaceState(null, '', url.toString());
  }

  applyFilter(initialTag);

  document.querySelectorAll<HTMLButtonElement>('.tag-btn').forEach(btn => {
    btn.addEventListener('click', () => applyFilter(btn.dataset.tag ?? 'all'));
  });
</script>
