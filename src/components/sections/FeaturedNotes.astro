---
import NoteCard from '../ui/NoteCard.astro';
import { getFeaturedNotes } from '../../lib/content';

const notes = await getFeaturedNotes();
---

{notes.length > 0 && (
  <section class="py-20 px-6">
    <div class="max-w-5xl mx-auto">
      <h2 class="fade-up text-2xl sm:text-3xl font-bold text-[var(--color-text)] mb-12 tracking-tight">
        精选 Notes
      </h2>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">
        {notes.map((note, i) => (
          <div class="fade-up" style={`transition-delay:${i * 80}ms`}>
            <NoteCard note={note} />
          </div>
        ))}
      </div>
    </div>
  </section>
)}
