---
import Button from '../ui/Button.astro';
---

<section class="relative min-h-[80vh] flex flex-col items-center justify-center text-center px-6 py-24 overflow-hidden">
  <!-- Purple glow background -->
  <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[700px] h-[700px] rounded-full bg-purple-600/20 blur-[140px]"></div>
    <div class="absolute top-1/4 left-1/4 w-[300px] h-[300px] rounded-full bg-violet-800/15 blur-[100px]"></div>
  </div>

  <h1 class="fade-up relative text-5xl sm:text-6xl lg:text-7xl font-bold leading-[1.1] tracking-tight">
    <span class="bg-gradient-to-b from-white to-white/70 bg-clip-text text-transparent">程序员。<br />AI 实践者。<br />产品构建者。</span>
  </h1>
  <p class="fade-up relative mt-6 max-w-lg text-lg text-[var(--color-muted)] leading-relaxed" style="transition-delay:120ms">
    分享 AI 工具实践、推荐系统分析、产品工程经验，以及一些自己构建的小项目。
  </p>
  <div class="fade-up relative flex flex-wrap gap-3 mt-8 justify-center" style="transition-delay:240ms">
    <Button href="/notes">读 AI Notes</Button>
    <Button href="/about" variant="outline">关于我</Button>
  </div>
</section>
