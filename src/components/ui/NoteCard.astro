---
import Tag from './Tag.astro';
import type { Note } from '../../lib/content';
import { formatDate } from '../../lib/utils';

interface Props {
  note: Note;
}
const { note } = Astro.props;
---

<a
  href={`/notes/${note.id}`}
  class="block p-5 rounded-2xl card-glass transition-all duration-200 cursor-pointer group"
>
  <Tag label={note.tag} />
  <h3 class="mt-3 text-base font-semibold text-[var(--color-text)] leading-snug group-hover:text-[var(--color-accent)] transition-colors duration-200">
    {note.title}
  </h3>
  <p class="mt-2 text-sm text-[var(--color-muted)] line-clamp-2 leading-relaxed">{note.description}</p>
  <p class="mt-3 text-xs text-[var(--color-muted)]">{formatDate(note.date)} · {note.readingTime} min read</p>
</a>
